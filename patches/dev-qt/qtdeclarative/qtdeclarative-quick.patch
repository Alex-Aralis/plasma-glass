+/*
+    Animations advance on QtCore's animation timer here, which ticks every 16 ms
+    by default: a 60 Hz cap on faster screens. Tick once per frame of the fastest
+    screen a window is shown on. (They advance by elapsed time, so their speed
+    doesn't depend on this.)
+ */
+void QSGGuiThreadRenderLoop::updateAnimationTimingInterval()
+{
+    if (qsg_useConsistentTiming())
+        return; // fixed steps of the default interval
+    float interval = 0;
+    for (auto it = m_windows.cbegin(); it != m_windows.cend(); ++it) {
+        if (it.key()->isVisible() && it.key()->isExposed() && it->vsyncInterval > 0
+            && (interval == 0 || it->vsyncInterval < interval)) {
+            interval = it->vsyncInterval;
+        }
+    }
+    // no window shown: QtCore's default
+    const int timingInterval = interval > 0 ? qMax(1, int(interval)) : 16;
+    if (timingInterval == m_animationTimingInterval)
+        return;
+    qCDebug(QSG_LOG_INFO, "Animation timer: %d ms (fastest screen with an exposed window)", timingInterval);
+    m_animationTimingInterval = timingInterval;
+    QUnifiedTimer::instance(true)->setTimingInterval(timingInterval);
 }
 

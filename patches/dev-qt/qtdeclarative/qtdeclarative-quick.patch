+/*
+    The animation driver starts with the primary screen's refresh rate, but with
+    one exposed window it advances by one frame of the screen that window is on,
+    and with several it ticks the system timer, which should keep up with the
+    fastest of their screens. A 60 Hz primary screen made a window on a 240 Hz
+    one deliver frames at "less than half" the expected interval, so it was
+    taken for broken vsync and animated from a 16 ms timer.
+ */
+void QSGThreadedRenderLoop::updateAnimationVsyncInterval()
+{
+    float interval = 0.0f;
+    for (const Window &w : std::as_const(m_windows)) {
+        if (w.window->isVisible() && w.window->isExposed() && w.vsyncInterval > 0
+            && (interval == 0.0f || w.vsyncInterval < interval)) {
+            interval = w.vsyncInterval;
+        }
+    }
+    if (interval == 0.0f) // no window shown: the primary screen's, as the driver started with
+        interval = qsg_vsyncIntervalFor(QGuiApplication::primaryScreen());
+    if (qFuzzyCompare(interval, sg->vsyncIntervalForAnimationDriver(m_animation_driver)))
+        return;
+
+    qCDebug(QSG_LOG_INFO, "Animation Driver: vsync %.2f ms (fastest screen with an exposed window)", interval);
+    sg->setVsyncIntervalForAnimationDriver(m_animation_driver, interval);
+    // the frame times sampled so far were judged against the old rate
+    for (Window &w : m_windows) {
+        w.psTimeAccumulator = 0.0f;
+        w.psTimeSampleCount = 0;
+    }
+    if (m_animation_timer != 0) {
+        killTimer(m_animation_timer);
+        m_animation_timer = startTimer(int(interval));
+    }
+}

+// The frame interval in ms of \a screen
+inline float qsg_vsyncIntervalFor(const QScreen *screen)
+{
+    const qreal refreshRate = screen ? screen->refreshRate() : 0;
+    // some platforms report 0 or something bogus, as in QSGAnimationDriver
+    return 1000.0f / float(refreshRate >= 1 ? refreshRate : 60);
+}
+
+// The frame interval in ms of the screen \a window is on. Animation timing has to follow the
+// screen a window is on, not the primary screen, which can refresh at another rate.
+inline float qsg_vsyncIntervalFor(const QWindow *window)
+{
+    return qsg_vsyncIntervalFor(window->screen());
+}

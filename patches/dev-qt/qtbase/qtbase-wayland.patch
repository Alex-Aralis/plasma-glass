+/*!
+ * Sets the viewport destination for a buffer of \a bufferSize device pixels that is about to be
+ * attached, so the surface takes its new size together with the content drawn for it.
+ * Can be called from the render thread.
+ */
+void QWaylandWindow::setViewportDestinationForBuffer(const QSize &bufferSize)
+{
+    QReadLocker locker(&mSurfaceLock);
+    if (mViewport && !bufferSize.isEmpty())
+        mViewport->setDestination((QSizeF(bufferSize) / scale()).toSize());
+}

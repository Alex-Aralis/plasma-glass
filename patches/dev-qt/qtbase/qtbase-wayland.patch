+void QWaylandEglWindow::frameStarted()
+{
+    QMutexLocker lock(&m_eglSurfaceLock);
+    if (m_resizePending) {
+        m_resizePending = false;
+        updateSurface(false);
+    }
+    m_inFrame = true;
+}
+
+void QWaylandEglWindow::frameEnded()
+{
+    QMutexLocker lock(&m_eglSurfaceLock);
+    m_inFrame = false;
+    if (m_resizePending) {
+        m_resizePending = false;
+        updateSurface(false);
+    }
+}

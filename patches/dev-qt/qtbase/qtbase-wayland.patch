+    // A frame that a render thread is drawing has the old size (its scene and viewport were set while
+    // the main thread was blocked), but the driver gives it a buffer of the new size if it allocates one
+    // after this: the old frame would land in the new buffer, bottom-aligned (GL's origin is
+    // bottom-left). So resize after that frame.
+    if (m_inFrame) {
+        m_resizePending = true;
+        return;
+    }

diff -ruN '--exclude=*.orig' '--exclude=*.rej' a/krunner/qml/busyfoil.frag b/krunner/qml/busyfoil.frag
--- a/krunner/qml/busyfoil.frag
+++ b/krunner/qml/busyfoil.frag
@@ -0,0 +1,56 @@
+/*
+    SPDX-FileCopyrightText: 2026 Alex Aralis
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+// The foil of KRunner's busy feedback on light glass (RunCommand.qml, drawn by busyripple.frag): shards
+// about `grain` px across (the Voronoi cells of a jittered grid), each with its own colour and sparkle.
+// Drawn once into a texture that tiles (the cells wrap every `cells` cells), not every frame. Out: the
+// shard's place on the spectrum (0..1) and its sparkle.
+#version 440
+
+layout(location = 0) in vec2 qt_TexCoord0;
+layout(location = 0) out vec4 fragColor;
+layout(std140, binding = 0) uniform buf {
+    mat4 qt_Matrix;
+    float qt_Opacity;
+    float grain; // px: the shards' size
+    float cells; // shards across (and down) the tile
+};
+
+// hashes without sine (Dave Hoskins), stable in float precision
+float hash12(vec2 p)
+{
+    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.x + p3.y) * p3.z);
+}
+
+vec2 hash22(vec2 p)
+{
+    vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.xx + p3.yz) * p3.zy);
+}
+
+void main()
+{
+    vec2 q = qt_TexCoord0 * cells;
+    vec2 cell = floor(q);
+    vec2 f = q - cell;
+    float best = 8.0;
+    vec2 id = cell;
+    for (int j = -1; j <= 1; ++j) {
+        for (int i = -1; i <= 1; ++i) {
+            vec2 c = mod(cell + vec2(float(i), float(j)), cells); // wraps, so the tile repeats seamlessly
+            vec2 o = vec2(float(i), float(j)) + hash22(c) - f;
+            float d2 = dot(o, o);
+            if (d2 < best) {
+                best = d2;
+                id = c;
+            }
+        }
+    }
+    fragColor = vec4(hash22(id + 17.17).y, 0.3 + 0.7 * hash12(id + 3.7), 0.0, 1.0);
+}
diff -ruN '--exclude=*.orig' '--exclude=*.rej' a/krunner/qml/busyripple.frag b/krunner/qml/busyripple.frag
--- a/krunner/qml/busyripple.frag
+++ b/krunner/qml/busyripple.frag
@@ -0,0 +1,84 @@
+/*
+    SPDX-FileCopyrightText: 2026 Alex Aralis
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+// KRunner's busy feedback (RunCommand.qml): waves run across the glass (their slope and height come from
+// busywaves.frag, at half resolution). On dark glass the light that comes in at the rim lets out where a
+// wave's slope faces it, and the content seen through the glass shifts along the slope, as refraction
+// does; on light glass a wave is a flat foil sheen in shards of colour instead.
+#version 440
+
+layout(location = 0) in vec2 qt_TexCoord0;
+layout(location = 0) out vec4 fragColor;
+layout(std140, binding = 0) uniform buf {
+    mat4 qt_Matrix;
+    float qt_Opacity;
+    vec2 itemSize;     // logical px
+    float radius;      // the glass's corner radius
+    float steep;       // steepest slope of a fresh wave
+    float refraction;  // px the content shifts per unit of slope (0: drawn straight)
+    vec4 rim;          // light at the rim: the style's rim at the top, sides, bottom; w: px it reaches in
+    float sheen;       // > 0: draw the waves as a flat foil sheen this strong instead of lit slopes
+    float foilTile;    // px: the size of the foil's tile
+    float foilSat;     // how saturated the shards are (0: white)
+    float time;        // s, for the shards' slow colour drift
+};
+layout(binding = 1) uniform sampler2D source; // the content (query, results), over the whole glass
+layout(binding = 2) uniform sampler2D waves;  // the glass's slope (x, y) and the waves' height
+layout(binding = 3) uniform sampler2D foil;   // the foil's shards (busyfoil.frag): place on the spectrum, sparkle
+
+float boxSdf(vec2 p, vec2 halfSize, float r)
+{
+    vec2 q = abs(p) - halfSize + r;
+    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
+}
+
+// a rainbow: w 0 (red) .. 1 (violet)
+vec3 spectral(float w)
+{
+    vec3 x = 3.2 * (w - vec3(0.18, 0.48, 0.78));
+    vec3 c = max(1.0 - x * x, 0.0);
+    c.r += 0.35 * max(1.0 - 10.0 * (w - 1.0) * (w - 1.0), 0.0); // violet has some red
+    return c;
+}
+
+void main()
+{
+    vec2 p = qt_TexCoord0 * itemSize;
+    float sdf = boxSdf(p - itemSize * 0.5, itemSize * 0.5, radius);
+    float cover = clamp(0.5 - sdf / fwidth(sdf), 0.0, 1.0);
+    float inside = smoothstep(0.0, 2.0, -sdf); // flat at the very rim
+    vec4 field = texture(waves, qt_TexCoord0);
+    vec2 slope = field.xy * inside;
+    float height = field.z * inside;
+
+    vec4 surface = vec4(0.0);
+    if (sheen > 0.0) {
+        // a flat sheen where a wave is, in shards of colour; drawn as a tint (colour col / alpha at alpha
+        // max(col)), so the colours show on bright glass too. The foil only where there's a wave to show it.
+        if (height > 0.002) {
+            vec2 shard = texture(foil, p / foilTile).xy; // the tile repeats
+            vec3 col = min(sheen * min(height, 1.0) * shard.y * mix(vec3(1.0), spectral(fract(shard.x + 0.03 * time)), foilSat),
+                           vec3(1.0));
+            surface = vec4(col, max(col.r, max(col.g, col.b))) * cover;
+        }
+    } else {
+        // light comes in at the rim, as strong as the style's rim there, and fades going in. A slope lets
+        // an edge's light out where it faces that edge, half of it side-on and none facing away.
+        vec2 tilt = -slope / steep; // where the surface faces; 1 for a fresh wave's steepest slope
+        float t = length(tilt);
+        if (t > 1e-3) {
+            vec4 dist = vec4(p.x, itemSize.x - p.x, p.y, itemSize.y - p.y); // to the left, right, top, bottom
+            vec4 edgeLight = vec4(rim.y, rim.y, rim.x, rim.z) * exp(-dist / rim.w);
+            vec2 f = tilt / t;
+            vec4 towards = clamp(0.5 + 0.5 * vec4(-f.x, f.x, -f.y, f.y), 0.0, 1.0);
+            float light = min(smoothstep(0.0, 1.0, t) * dot(edgeLight, towards), max(rim.x, max(rim.y, rim.z)));
+            surface = vec4(light) * cover; // white, premultiplied
+        }
+    }
+    // the content seen through the glass, shifted along the slope as refraction does
+    vec4 content = texture(source, qt_TexCoord0 + refraction * slope / itemSize);
+    fragColor = (content + surface * (1.0 - content.a)) * qt_Opacity;
+}
diff -ruN '--exclude=*.orig' '--exclude=*.rej' a/krunner/qml/busywaves.frag b/krunner/qml/busywaves.frag
--- a/krunner/qml/busywaves.frag
+++ b/krunner/qml/busywaves.frag
@@ -0,0 +1,136 @@
+/*
+    SPDX-FileCopyrightText: 2026 Alex Aralis
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+// The waves of KRunner's busy feedback (RunCommand.qml, drawn by busyripple.frag): knocks on the glass's rim
+// each send one wave across it. A knock flexes its side, most at the knock and not at all at the corners,
+// and the side pushes the wave in; waves fade with time and as they head into a rim. Out: the glass's slope
+// (x, y) and the waves' height. Rendered at half the window's resolution, since the waves are broad.
+#version 440
+
+layout(location = 0) in vec2 qt_TexCoord0;
+layout(location = 0) out vec4 fragColor;
+layout(std140, binding = 0) uniform buf {
+    mat4 qt_Matrix;
+    float qt_Opacity;
+    vec2 itemSize; // logical px
+    // a knock (worked out once per frame in RunCommand.qml): side (0 left, 1 right, 2 top, 3 bottom), px
+    // along it, how far its wave has come (px), the wave's half-width (px)
+    vec4 knock0;
+    vec4 knock1;
+    vec4 knock2;
+    vec4 knock3;
+    vec4 knock4;
+    vec4 knock5;
+    vec4 knock6;
+    vec4 knock7;
+    // and: how much of the wave is left with age (0: none, nothing to add), the exponent that puts the
+    // side's flex peak at the knock
+    vec4 shape0;
+    vec4 shape1;
+    vec4 shape2;
+    vec4 shape3;
+    vec4 shape4;
+    vec4 shape5;
+    vec4 shape6;
+    vec4 shape7;
+    float steep; // steepest slope of a fresh wave
+};
+
+// One knock's wave at p: adds its slope and height. The flex starts on a 1 px stretch at once and slows
+// down over 30 px to the waves' speed (its time per px rises as a smoothstep), so the wave leaves as a
+// short, rounded front. `die`: how much of a wave heading for the nearest rim is left at p; `toRim`: the
+// way to that rim.
+void knock(vec2 p, vec4 k, vec4 shape, float die, vec2 toRim, inout vec2 slope, inout float height)
+{
+    if (shape.x <= 0.0)
+        return;
+    // p in the side's terms: n px in from it, s px along it (len long); `inward`, `along`: those directions
+    float n;
+    float s;
+    float len;
+    vec2 inward;
+    vec2 along;
+    if (k.x < 0.5) {
+        n = p.x; s = p.y; len = itemSize.y; inward = vec2(1.0, 0.0); along = vec2(0.0, 1.0);
+    } else if (k.x < 1.5) {
+        n = itemSize.x - p.x; s = p.y; len = itemSize.y; inward = vec2(-1.0, 0.0); along = vec2(0.0, 1.0);
+    } else if (k.x < 2.5) {
+        n = p.y; s = p.x; len = itemSize.x; inward = vec2(0.0, 1.0); along = vec2(1.0, 0.0);
+    } else {
+        n = itemSize.y - p.y; s = p.x; len = itemSize.x; inward = vec2(0.0, -1.0); along = vec2(1.0, 0.0);
+    }
+    float front = k.z;
+    float wb = k.w;
+    float a = abs(s - k.y);
+    // The wave has come between n and the straight line from the knock; 2.5 half-widths off its crest,
+    // what's left (under 0.2% of its height, 5% of its slope) doesn't show
+    float behind = front - 2.5 * wb;
+    if (front + 2.5 * wb < n || (behind > 0.0 && behind * behind > a * a + n * n))
+        return;
+    // The first wave to reach p left the side where the flex's time to get there plus the path on to p is
+    // shortest (both as distances at the waves' speed). That's convex along the side: bisect its slope.
+    // Past the 30 px where the flex slows down it moves as fast as the waves, so no later start is shorter:
+    // the search only spans those 30 px, and 4 halvings do (an error there changes `from` only to second
+    // order).
+    const float w = 0.5;  // half the stretch that moves at once (px)
+    const float L = 30.0; // px over which the flex slows down to the waves' speed
+    float from = n;       // how far the wave has come
+    vec2 dir = inward;    // and its direction at p
+    if (a > w) {
+        float lo = w;
+        float hi = min(a, w + L);
+        for (int i = 0; i < 4; ++i) {
+            float mid = 0.5 * (lo + hi);
+            float xm = clamp((mid - w) / L, 0.0, 1.0);
+            float dm = a - mid;
+            if (xm * xm * (3.0 - 2.0 * xm) < dm / sqrt(dm * dm + n * n + 1e-6))
+                lo = mid;
+            else
+                hi = mid;
+        }
+        float d = 0.5 * (lo + hi);
+        float xd = clamp((d - w) / L, 0.0, 1.0);
+        float dd = a - d;
+        float r = sqrt(dd * dd + n * n);
+        from = L * xd * xd * xd * (1.0 - 0.5 * xd) + max(d - w - L, 0.0) + r;
+        dir = (n * inward + sign(s - k.y) * dd * along) / max(r, 1e-3);
+    }
+    // how strongly the side moves there: sin^2 of a warped position that puts its peak at the knock
+    float flex = sin(3.14159265 * pow(clamp(s / len, 0.0, 1.0), shape.y));
+    float fade = flex * flex * shape.x * mix(1.0, die, smoothstep(-0.3, 0.3, dot(dir, toRim)));
+    float x = (from - front) / wb;
+    float h = exp(-x * x);
+    slope += steep * fade * (-2.0 * x * h / 0.8578) * dir; // 0.8578: the steepest of 2x e^(-x^2)
+    height += fade * h;
+}
+
+void main()
+{
+    vec2 p = qt_TexCoord0 * itemSize;
+    vec4 dist = vec4(p.x, itemSize.x - p.x, p.y, itemSize.y - p.y); // to the left, right, top, bottom edge
+    // a wave heading into the rim fades out within a few px of it (from 40 px in, all of it is left)
+    float die = 1.0;
+    vec2 toRim = vec2(0.0);
+    if (min(min(dist.x, dist.y), min(dist.z, dist.w)) < 40.0) {
+        vec4 ed = exp(-dist / 8.0);
+        float near = ed.x + ed.y + ed.z + ed.w;
+        die = exp(-(near * near) / (0.45 * 0.45));
+        vec4 e = exp(-dist / 20.0);
+        vec2 rimward = vec2(e.y - e.x, e.w - e.z);
+        toRim = rimward / max(length(rimward), 1e-4);
+    }
+    vec2 slope = vec2(0.0);
+    float height = 0.0;
+    knock(p, knock0, shape0, die, toRim, slope, height);
+    knock(p, knock1, shape1, die, toRim, slope, height);
+    knock(p, knock2, shape2, die, toRim, slope, height);
+    knock(p, knock3, shape3, die, toRim, slope, height);
+    knock(p, knock4, shape4, die, toRim, slope, height);
+    knock(p, knock5, shape5, die, toRim, slope, height);
+    knock(p, knock6, shape6, die, toRim, slope, height);
+    knock(p, knock7, shape7, die, toRim, slope, height);
+    fragColor = vec4(slope, height, 1.0);
+}

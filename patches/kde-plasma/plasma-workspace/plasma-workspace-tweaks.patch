+// Layer-shell placement for the floating window: anchored to the top with a margin, and either centred
+// (stock) or anchored left with a margin that puts its centre at m_floatCenterX.
+void View::applyFloatingMargins()
+{
+    if (!KWindowSystem::isPlatformWayland()) {
+        return;
+    }
+    auto layerWindow = LayerShellQt::Window::get(this);
+    QMargins layerMargins = margins();
+    if (m_floating && m_floatCenterX != 0.5) {
+        const int screenWidth = screen()->availableGeometry().width();
+        layerMargins.setLeft(std::clamp(qRound(screenWidth * m_floatCenterX - width() / 2.0), 0, std::max(0, screenWidth - width())));
+        layerWindow->setAnchors(LayerShellQt::Window::Anchors(LayerShellQt::Window::AnchorTop | LayerShellQt::Window::AnchorLeft));
+    } else {
+        layerWindow->setAnchors(LayerShellQt::Window::AnchorTop);
+    }
+    layerWindow->setMargins(layerMargins);
+}
+
+QPointF View::floatingTopLeft()
+{
+    const QRect r = screen()->availableGeometry();
+    return {std::clamp(r.width() * m_floatCenterX - width() / 2.0, 0.0, std::max(0.0, qreal(r.width() - width()))), r.height() * m_floatTop};
+}
+
+// Moves the floating window to a top-left position (kept on screen) and stores it as fractions.
+void View::moveFloatingTo(QPointF topLeft)
+{
+    const QRect r = screen()->availableGeometry();
+    if (r.width() <= 0 || r.height() <= 0) {
+        return;
+    }
+    const qreal left = std::clamp(topLeft.x(), 0.0, std::max(0.0, qreal(r.width() - width())));
+    const qreal top = std::clamp(topLeft.y(), 0.0, std::max(0.0, qreal(r.height() - height())));
+    m_floatCenterX = (left + width() / 2.0) / r.width();
+    m_floatTop = top / r.height();
+    applyFloatingMargins();
+    update(); // margins only take effect with a commit, so render a frame even if nothing changed
+}
+
+// A relative pointer for the current wl_pointer, kept while KRunner runs so no motion is missed at a press.
+void View::ensureRelativePointer()
+{
+    if (!KWindowSystem::isPlatformWayland()) {
+        return;
+    }
+    auto wayland = qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>();
+    ::wl_pointer *pointer = wayland ? wayland->pointer() : nullptr;
+    if (!pointer || (m_relativePointer && m_relativePointer->forPointer == pointer)) {
+        return;
+    }
+    if (!m_relativePointerManager) {
+        m_relativePointerManager = std::make_unique<RelativePointerManager>();
+    }
+    if (!m_relativePointerManager->isActive()) {
+        return;
+    }
+    m_relativePointer = std::make_unique<RelativePointer>(m_relativePointerManager->get_relative_pointer(pointer), pointer, [this](QPointF delta) {
+        if (m_dragging) {
+            m_dragFollowed = true;
+            // the cursor stops at the screen edge but relative motion doesn't; stop with it, so the
+            // window comes back with the cursor
+            const QRect r = screen()->geometry();
+            const QPointF press = m_dragStart + m_dragPress;
+            const QPointF pointer = press + m_dragOffset + delta;
+            m_dragOffset = QPointF(std::clamp(pointer.x(), 0.0, r.width() - 1.0), std::clamp(pointer.y(), 0.0, r.height() - 1.0)) - press;
+            moveFloatingTo(m_dragStart + m_dragOffset);
+        }
+    });
+}
+
+int View::moveModifier() const
+{
+    const QString key = KConfigGroup(KSharedConfig::openConfig(u"kwinrc"_s), u"MouseBindings"_s).readEntry("CommandAllKey", u"Meta"_s);
+    return key == u"Alt"_s ? Qt::AltModifier : Qt::MetaModifier;
+}
+
+void View::startFloatingDrag(qreal x, qreal y)
+{
+    if (!m_floating || !KWindowSystem::isPlatformWayland()) {
+        return;
+    }
+    ensureRelativePointer();
+    m_dragging = true;
+    m_dragFollowed = false;
+    m_dragStart = floatingTopLeft();
+    m_dragOffset = {};
+    m_dragPress = {x, y};
+}
+
+void View::endFloatingDrag(qreal x, qreal y)
+{
+    if (!m_dragging) {
+        return;
+    }
+    m_dragging = false;
+    if (!m_dragFollowed && qIsFinite(x) && qIsFinite(y)) {
+        // no relative motion (compositor without the protocol): the window stayed put, so the release
+        // position in it is the whole move
+        m_dragOffset = QPointF(x, y) - m_dragPress;
+        moveFloatingTo(m_dragStart + m_dragOffset);
+    }
+    if (m_dragOffset.isNull()) {
+        return;
+    }
+    m_config.writeEntry("FloatingTop", m_floatTop);
+    m_config.writeEntry("FloatingCenterX", m_floatCenterX);
+    m_config.sync();
+}

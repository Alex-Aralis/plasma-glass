+        l.axis_source = [](void *, wl_pointer *, uint32_t) { };
+        l.axis_stop = [](void *, wl_pointer *, uint32_t, uint32_t) { };
+        l.axis_discrete = [](void *, wl_pointer *, uint32_t, int32_t) { };

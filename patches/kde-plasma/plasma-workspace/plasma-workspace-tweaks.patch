+static const QString s_indexerService = u"local.embedsearch"_s;
+static const QString s_indexerPath = u"/indexer"_s;
+static const QString s_indexerInterface = u"local.embedsearch.Indexer"_s;
+
+void View::watchIndexer()
+{
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    bus.connect(s_indexerService,
+                s_indexerPath,
+                u"org.freedesktop.DBus.Properties"_s,
+                u"PropertiesChanged"_s,
+                this,
+                SLOT(indexerPropertiesChanged(QString, QVariantMap, QStringList)));
+    auto watcher = new QDBusServiceWatcher(s_indexerService, bus, QDBusServiceWatcher::WatchForOwnerChange, this);
+    connect(watcher, &QDBusServiceWatcher::serviceOwnerChanged, this, [this](const QString &, const QString &, const QString &owner) {
+        if (owner.isEmpty()) {
+            setIndexingProgress(-1); // gone, maybe in the middle of a run
+        } else {
+            fetchIndexingProgress();
+        }
+    });
+    fetchIndexingProgress();
+}
+
+void View::fetchIndexingProgress()
+{
+    QDBusMessage message = QDBusMessage::createMethodCall(s_indexerService, s_indexerPath, u"org.freedesktop.DBus.Properties"_s, u"Get"_s);
+    message << s_indexerInterface << u"Progress"_s;
+    message.setAutoStartService(false); // D-Bus activatable: don't start it just to ask
+    auto call = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), this);
+    connect(call, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *call) {
+        call->deleteLater();
+        const QDBusPendingReply<QDBusVariant> reply = *call;
+        setIndexingProgress(reply.isValid() ? reply.value().variant().toDouble() : -1);
+    });
+}
+
+void View::indexerPropertiesChanged(const QString &interface, const QVariantMap &changed, const QStringList &)
+{
+    if (interface == s_indexerInterface && changed.contains(u"Progress"_s)) {
+        setIndexingProgress(changed.value(u"Progress"_s).toDouble());
+    }
+}
+
+void View::setIndexingProgress(qreal progress)
+{
+    if (progress != m_indexingProgress) {
+        m_indexingProgress = progress;
+        Q_EMIT indexingProgressChanged();
+    }
+}

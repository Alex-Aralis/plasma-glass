+void View::loadLiquidGlass()
+{
+    QVariantMap settings;
+    const QMap<QString, QString> entries = m_liquidGlassConfig->group(u"Ripple"_s).entryMap();
+    for (auto it = entries.cbegin(); it != entries.cend(); ++it) {
+        bool number = false;
+        const double value = it.value().toDouble(&number);
+        settings.insert(it.key(), number ? QVariant(value) : QVariant(it.value()));
+    }
+    // the heartbeat comes every 2 s; the settings only change while someone tunes them
+    const double left = settings.take(u"tuning"_s).toDouble() - QDateTime::currentMSecsSinceEpoch() / 1000.0;
+    if (settings != m_liquidGlass) {
+        m_liquidGlass = settings;
+        Q_EMIT liquidGlassChanged();
+    }
+    const bool tuning = left > 0;
+    if (tuning) {
+        m_tuningTimer.start(std::chrono::milliseconds(qint64(left * 1000) + 50));
+    }
+    if (tuning != m_tuning) {
+        m_tuning = tuning;
+        Q_EMIT tuningChanged();
+        // tuning is over: close as losing the focus would have
+        if (!tuning && isVisible()) {
+            slotFocusWindowChanged();
+        }
+    }
+}

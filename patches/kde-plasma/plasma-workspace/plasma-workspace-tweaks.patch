+// A wl_pointer of KRunner's own next to Qt's, for its buttons: when the window moves to another screen
+// during a drag, the press is over as far as Qt knows (it sends a release of its own as the surface
+// goes), but the compositor still says when the button really comes up.
+class ButtonWatcher
+{
+public:
+    ButtonWatcher(::wl_seat *seat, std::function<void(bool pressed)> onButton)
+        : forSeat(seat)
+        , m_pointer(wl_seat_get_pointer(seat))
+        , m_onButton(std::move(onButton))
+    {
+        wl_pointer_add_listener(m_pointer, &s_listener, this);
+    }
+    ~ButtonWatcher()
+    {
+        if (wl_pointer_get_version(m_pointer) >= WL_POINTER_RELEASE_SINCE_VERSION) {
+            wl_pointer_release(m_pointer);
+        } else {
+            wl_pointer_destroy(m_pointer);
+        }
+    }
+    ::wl_seat *const forSeat;
+
+private:
+    static wl_pointer_listener makeListener()
+    {
+        // every event needs a handler; all but the button are ignored
+        wl_pointer_listener l{};
+        l.enter = [](void *, wl_pointer *, uint32_t, wl_surface *, wl_fixed_t, wl_fixed_t) { };
+        l.leave = [](void *, wl_pointer *, uint32_t, wl_surface *) { };
+        l.motion = [](void *, wl_pointer *, uint32_t, wl_fixed_t, wl_fixed_t) { };
+        l.button = [](void *data, wl_pointer *, uint32_t, uint32_t, uint32_t, uint32_t state) {
+            static_cast<ButtonWatcher *>(data)->m_onButton(state == WL_POINTER_BUTTON_STATE_PRESSED);
+        };
+        l.axis = [](void *, wl_pointer *, uint32_t, uint32_t, wl_fixed_t) { };
+        l.frame = [](void *, wl_pointer *) { };
+        l.axis_source = [](void *, wl_pointer *, uint32_t) { };
+        l.axis_stop = [](void *, wl_pointer *, uint32_t, uint32_t) { };
+        l.axis_discrete = [](void *, wl_pointer *, uint32_t, int32_t) { };
+#ifdef WL_POINTER_AXIS_VALUE120_SINCE_VERSION
+        l.axis_value120 = [](void *, wl_pointer *, uint32_t, int32_t) { };
+#endif
+#ifdef WL_POINTER_AXIS_RELATIVE_DIRECTION_SINCE_VERSION
+        l.axis_relative_direction = [](void *, wl_pointer *, uint32_t, uint32_t) { };
+#endif
+#ifdef WL_POINTER_WARP_SINCE_VERSION
+        l.warp = [](void *, wl_pointer *, wl_fixed_t, wl_fixed_t) { };
+#endif
+        return l;
+    }
+    static const wl_pointer_listener s_listener;
+    ::wl_pointer *m_pointer;
+    std::function<void(bool)> m_onButton;
+};
+const wl_pointer_listener ButtonWatcher::s_listener = ButtonWatcher::makeListener();

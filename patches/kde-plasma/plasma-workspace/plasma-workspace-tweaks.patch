+    // Busy feedback with software rendering (no shaders for busyRipple): a band of light sweeps across the
+    // glass, under the content. The band is this rounded rectangle's gradient, so it keeps to the glass's
+    // corners at every size (a layer mask lagged behind the window while the results folded away).
+    property Item busyPulse: Rectangle {
+        id: busyPulse
+        parent: root.parent
+        anchors.fill: parent
+        z: -0.5 // over the glass, under the query and the results
+        radius: 26 // Liquid Glass's corner radius (generate.py R)
+        readonly property bool active: root.busy && !busyRipple.shaders
+        property real progress: 0 // 0..1: the band from off the left edge to off the right one
+        // until the band is off the glass: a sweep under way when the search ends runs to the end
+        visible: pulseSweep.running || (progress > 0 && progress < 1)
+
+        readonly property real halfWidth: 0.2 // of the glass's width
+        readonly property real center: -halfWidth + progress * (1 + 2 * halfWidth)
+        // brighter on light glass, where a faint highlight would vanish
+        readonly property real peak: Kirigami.ColorUtils.brightnessForColor(Kirigami.Theme.backgroundColor) === Kirigami.ColorUtils.Light ? 0.5 : 0.2
+        // the band's opacity profile, a peak falling off linearly; stops at its corners reproduce it
+        // exactly, also where it's partly off the glass
+        function light(position: real): color {
+            return Qt.rgba(1, 1, 1, peak * Math.max(0, 1 - Math.abs(position - center) / halfWidth));
+        }
+        function onGlass(position: real): real {
+            return Math.min(1, Math.max(0, position));
+        }
+        gradient: Gradient {
+            orientation: Gradient.Horizontal
+            GradientStop { position: 0; color: busyPulse.light(0) }
+            GradientStop { readonly property real at: busyPulse.onGlass(busyPulse.center - busyPulse.halfWidth); position: at; color: busyPulse.light(at) }
+            GradientStop { readonly property real at: busyPulse.onGlass(busyPulse.center); position: at; color: busyPulse.light(at) }
+            GradientStop { readonly property real at: busyPulse.onGlass(busyPulse.center + busyPulse.halfWidth); position: at; color: busyPulse.light(at) }
+            GradientStop { position: 1; color: busyPulse.light(1) }
+        }

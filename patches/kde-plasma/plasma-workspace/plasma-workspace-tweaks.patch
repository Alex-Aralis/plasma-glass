+// A relative pointer for the current wl_pointer, kept while KRunner runs so no motion is missed at a press.
+void View::ensureRelativePointer()
+{
+    if (!KWindowSystem::isPlatformWayland()) {
+        return;
+    }
+    auto wayland = qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>();
+    ::wl_seat *seat = wayland ? wayland->seat() : nullptr;
+    if (seat && (!m_buttonWatcher || m_buttonWatcher->forSeat != seat)) {
+        m_buttonWatcher = std::make_unique<ButtonWatcher>(seat, [this](bool) {
+            // after a move to another screen, the drag ends when the button comes up (or, had that
+            // been missed, at the next press)
+            if (m_dragging && m_dragChangedScreen && !m_changingScreen) {
+                finishFloatingDrag(qQNaN(), qQNaN());
+            }
+        });
+    }
+    ::wl_pointer *pointer = wayland ? wayland->pointer() : nullptr;
+    if (!pointer || (m_relativePointer && m_relativePointer->forPointer == pointer)) {
+        return;
+    }
+    if (!m_relativePointerManager) {
+        m_relativePointerManager = std::make_unique<RelativePointerManager>();
+    }
+    if (!m_relativePointerManager->isActive()) {
+        return;
+    }
+    m_relativePointer = std::make_unique<RelativePointer>(m_relativePointerManager->get_relative_pointer(pointer), pointer, [this](QPointF delta) {
+        if (!m_dragging || m_changingScreen) {
+            return;
+        }
+        m_dragFollowed = true;
+        // The cursor stops at the edges of the desktop but relative motion doesn't; stop with it, so
+        // the window comes back with the cursor. Onto another screen, the window goes along.
+        const QPointF moved = m_dragPointer + delta;
+        QScreen *onScreen = QGuiApplication::screenAt(moved.toPoint());
+        if (!onScreen) {
+            onScreen = screen();
+            const QRect r = onScreen->geometry();
+            m_dragPointer = QPointF(std::clamp(moved.x(), qreal(r.left()), r.right() + 0.0), std::clamp(moved.y(), qreal(r.top()), r.bottom() + 0.0));
+        } else {
+            m_dragPointer = moved;
+        }
+        const QPointF topLeft = m_dragPointer - m_dragPress;
+        if (onScreen != screen()) {
+            moveToScreen(onScreen, topLeft);
+        } else {
+            moveFloatingTo(topLeft - screen()->availableGeometry().topLeft());
+        }
+    });
+}

+
+    // Drag the floating window from any spot nothing else uses (the glass rim beside the content). It sits
+    // under this layout, across the whole window, and the window remembers where it was left.
+    // Modifier+drag anywhere is RunnerWindow's own (C++), so the content never sees that press.
+    property Item dragArea: MouseArea {
+        parent: root.parent
+        anchors.fill: parent
+        z: -1
+        cursorShape: pressed ? Qt.ClosedHandCursor : Qt.ArrowCursor
+        // the window follows the pointer itself (positions in it lag behind its moves)
+        onPressed: mouse => root.runnerWindow.startFloatingDrag(mouse.x, mouse.y)
+        onReleased: mouse => root.runnerWindow.endFloatingDrag(mouse.x, mouse.y)
+        onCanceled: root.runnerWindow.endFloatingDrag(NaN, NaN)
+    }
+    // Busy feedback with software rendering (no shaders, so no liquid): a band of light sweeps across the
+    // glass, under the content. The band is this rounded rectangle's gradient, so it keeps to the glass's
+    // corners at every size (a layer mask lagged behind the window while the results folded away).
+    property Item busyPulse: Rectangle {

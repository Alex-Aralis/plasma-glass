+void View::startFloatingDrag(qreal x, qreal y)
+{
+    if (!m_floating || !KWindowSystem::isPlatformWayland()) {
+        return;
+    }
+    ensureRelativePointer();
+    m_dragging = true;
+    m_dragFollowed = false;
+    m_dragChangedScreen = false;
+    m_dragStart = floatingTopLeft();
+    m_dragPress = {x, y};
+    m_dragPointer = screen()->availableGeometry().topLeft() + m_dragStart + m_dragPress;
+}
+
+void View::endFloatingDrag(qreal x, qreal y)
+{
+    // Moving to another screen hides the window, which ends the press as far as Qt knows: the drag goes
+    // on, and the ButtonWatcher ends it.
+    if (!m_dragging || m_changingScreen || m_dragChangedScreen) {
+        return;
+    }
+    finishFloatingDrag(x, y);
+}
+
+// The press of a modifier+drag never reaches Qt Quick, nor anything else until the drag ends: an item
+// that takes a press doesn't stop the pointer handlers under it from seeing it too, and a result's
+// DragHandler took over once the window changed screens (which ends the item's grab) and started a
+// drag and drop of that result.
+bool View::event(QEvent *event)
+{
+    // (QQuickWindow::event delivers pointer events to Qt Quick unless they come in unaccepted, which
+    // they don't, so overriding mousePressEvent() and the like can't keep them away)
+    const QEvent::Type type = event->type();
+    if (type == QEvent::MouseButtonPress || type == QEvent::MouseButtonRelease || type == QEvent::MouseButtonDblClick
+        || type == QEvent::MouseMove) {
+        auto mouse = static_cast<QMouseEvent *>(event);
+        if (m_modifierDrag && m_dragging) {
+            if (type == QEvent::MouseButtonRelease && mouse->button() == Qt::LeftButton) {
+                endFloatingDrag(mouse->position().x(), mouse->position().y());
+            }
+            return true;
+        }
+        if (type == QEvent::MouseButtonPress && mouse->button() == Qt::LeftButton && (mouse->modifiers() & moveModifier())
+            && m_floating && KWindowSystem::isPlatformWayland()) {
+            m_modifierDrag = true;
+            m_cursorBeforeDrag = cursor();
+            setCursor(Qt::SizeAllCursor);
+            startFloatingDrag(mouse->position().x(), mouse->position().y());
+            return true;
+        }
+    }
+    return PlasmaQuick::PlasmaWindow::event(event);
+}
+
+void View::finishFloatingDrag(qreal x, qreal y)
+{
+    m_dragging = false;
+    if (m_modifierDrag) {
+        m_modifierDrag = false;
+        setCursor(m_cursorBeforeDrag);
+    }
+    if (!m_dragFollowed) {
+        if (!qIsFinite(x) || !qIsFinite(y) || QPointF(x, y) == m_dragPress) {
+            return; // a click
+        }
+        // no relative motion (compositor without the protocol): the window stayed put, so the release
+        // position in it is the whole move
+        moveFloatingTo(m_dragStart + QPointF(x, y) - m_dragPress);
+    }
+    if (!isActive()) {
+        requestActivate(); // the focus left with the window on the previous screen
+    }
+    m_floatScreen = screen()->name();
+    m_config.writeEntry("FloatingTop", m_floatTop);
+    m_config.writeEntry("FloatingCenterX", m_floatCenterX);
+    m_config.writeEntry("FloatingScreen", m_floatScreen);
+    m_config.sync();
+}
+
+// A layer-shell surface stays on the output it was made for, so the window is shown again on the
+// other screen, with its top-left at \a topLeft (global coordinates). QML keeps the query and results
+// meanwhile (changingScreen).
+void View::moveToScreen(QScreen *screen, QPointF topLeft)
+{
+    m_dragChangedScreen = true;
+    m_changingScreen = true;
+    Q_EMIT changingScreenChanged();
+    setVisible(false);
+    setScreen(screen);
+    if (KWindowSystem::isPlatformWayland()) {
+        LayerShellQt::Window::get(this)->setScreen(screen);
+    }
+    moveFloatingTo(topLeft - screen->availableGeometry().topLeft());
+    setVisible(true);
+    requestActivate();
+    m_changingScreen = false;
+    Q_EMIT changingScreenChanged();
+}

@@ -74,6 +74,23 @@
         tab->addTab(mPip->widget(), i18n("&Picture-in-picture"));
         connectKCM(mPip);
     }
+
+    // "systemsettings kcm_kwinoptions --args focus" opens on a tab, also when the page is already open
+    selectTab(args);
+    connect(this, &KCModule::activationRequested, this, &KWinOptions::selectTab);
+}
+
+void KWinOptions::selectTab(const QVariantList &args)
+{
+    static const QStringList tabs{QStringLiteral("focus"), QStringLiteral("titlebar-actions"), QStringLiteral("window-actions"),
+                                  QStringLiteral("movement"), QStringLiteral("advanced"), QStringLiteral("pip")};
+    for (const QVariant &arg : args) {
+        const int index = tabs.indexOf(arg.toString());
+        if (index >= 0 && index < tab->count()) {
+            tab->setCurrentIndex(index);
+            return;
+        }
+    }
 }
 

+void BlurEffect::Knock(double born, int side, double at, const QVariantMap &wave)
+{
+    if (!calledFromDBus()) {
+        return;
+    }
+    const QDBusReply<uint> pid = connection().interface()->servicePid(message().service());
+    if (!pid.isValid()) {
+        return;
+    }
+    const LiquidGlassKnock knock{
+        .born = born,
+        .side = side,
+        .at = at,
+        .speed = wave.value(QStringLiteral("speed"), 120.0).toDouble(),
+        .bump = wave.value(QStringLiteral("bump"), 21.0).toDouble(),
+        .spread = wave.value(QStringLiteral("spread"), 8.0).toDouble(),
+        .damping = wave.value(QStringLiteral("damping"), 36.0).toDouble(),
+        .life = wave.value(QStringLiteral("life"), 9.5).toDouble(),
+        .steep = wave.value(QStringLiteral("steep"), 0.5).toDouble(),
+        .lean = wave.value(QStringLiteral("lean"), s_liquidGlassRipple).toDouble(),
+        .dispersion = wave.value(QStringLiteral("dispersion"), s_liquidGlassRippleDispersion).toDouble(),
+        .ring = std::max(wave.value(QStringLiteral("ring"), 1.7).toDouble(), 0.1),
+        .norm = std::max(wave.value(QStringLiteral("norm"), 0.991).toDouble(), 0.01),
+        .edge = std::max(wave.value(QStringLiteral("edge"), 3.0).toDouble(), 0.5),
+    };
+    for (auto &[window, data] : m_windows) {
+        if (window->pid() == pid_t(pid.value())) {
+            data.knocks.push_back(knock);
+            if (data.knocks.size() > 8) { // as many as the shader takes
+                data.knocks.erase(data.knocks.begin());
+            }
+            window->addRepaintFull();
+        }
+    }
+}

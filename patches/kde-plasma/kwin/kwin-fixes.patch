+// The kernel zeroes a new buffer's pages through the CPU cache, and a device that doesn't snoop it (an
+// NVidia card writing into a buffer of an Intel iGPU) writes around those lines. When they're written
+// back, at the latest when the display driver flushes the buffer to show it, the zeros land on the
+// copy: the cursor on a screen of the iGPU showed with rows missing, and when the machine was idle (so
+// the cache kept them) not at all. Write them back before the device writes.
+static void flushCpuCache(GraphicsBuffer *buffer)
+{
+#if defined(__x86_64__)
+    const DmaBufAttributes *attributes = buffer->dmabufAttributes();
+    if (!attributes || attributes->planeCount != 1) {
+        return;
+    }
+    const int fd = attributes->fd[0].get();
+    const size_t size = attributes->offset[0] + size_t(attributes->pitch[0]) * attributes->height;
+    void *map = mmap(nullptr, size, PROT_READ, MAP_SHARED, fd, 0);
+    if (map == MAP_FAILED) {
+        qCWarning(KWIN_VULKAN) << "Could not map a new buffer to flush it from the CPU cache:" << strerror(errno);
+        return;
+    }
+    dma_buf_sync sync{.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ};
+    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    for (size_t offset = 0; offset < size; offset += 64) {
+        _mm_clflush(static_cast<const char *>(map) + offset);
+    }
+    _mm_mfence();
+    sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ;
+    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    munmap(map, size);
+#else
+    Q_UNUSED(buffer)
+#endif
+}

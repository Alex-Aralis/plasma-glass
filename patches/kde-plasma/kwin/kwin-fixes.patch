diff -ruN '--exclude=*.orig' '--exclude=*.rej' a/src/plugins/blur/shaders/fluid.frag b/src/plugins/blur/shaders/fluid.frag
--- a/src/plugins/blur/shaders/fluid.frag
+++ b/src/plugins/blur/shaders/fluid.frag
@@ -0,0 +1,248 @@
+#version 140
+
+#include "sdf.glsl"
+
+// plasma-glass: one step of the liquid in a Liquid Glass window (KRunner's): linear shallow water on a
+// staggered grid, worked forward then back (the faces' new velocities from the old heights, then the new
+// heights from those velocities), which keeps waves stable while c dt / cell stays under 1/sqrt(2). Each
+// texel is a cell: its height (px), the velocity on its right face and on its bottom face (px/s), and 1 if
+// it holds liquid. Cell (i, j) sits at ((i - 0.5) cell, (j - 0.5) cell) in the glass (y down), so row and
+// column 0 lie outside it. The liquid's edge, its shore, runs a little in from the glass's rim in gentle
+// bends, so the waves it sends off and sends back aren't ruler-straight; every shore is a face between a
+// dry cell and a wet one. Dry cells stay at rest; a cell the glass has just grown over starts at the level
+// of the nearest liquid above it or to its left (the glass grows down and to the right), so no step is left
+// to ring. Its floor isn't flat either: waves run faster where the liquid is deeper (c^2 goes with the
+// depth), so their fronts bend as they cross, as on a real shore. The shore holds the liquid in, except
+// where the busy push pushes it in; the glass's acceleration (its centre's, so growing counts too) pushes
+// the liquid the other way (momentum); and while busy a breeze, gusts pressing here and there that come
+// and go, raises small waves all over.
+
+uniform sampler2D state;
+uniform vec2 glass;        // the glass's size, logical px
+uniform vec4 corners;      // and its corners' radii: top left, top right, bottom left, bottom right
+uniform float cell;        // logical px a cell
+uniform vec4 timing;       // dt (s), c^2 (px^2/s^2), diffusion (px^2/s), how fast the level settles (1/s)
+uniform vec3 damping;      // the faces' velocities fade at this rate (1/s), and in the rim's band up to this
+                           // much more (the sponge, 1/s), over this many px in from the rim
+uniform vec2 accel;        // px/s^2: what the glass's acceleration does to the liquid (minus it, scaled)
+uniform vec4 push;         // the busy push: its side (0 left, 1 right, 2 top, 3 bottom; -1 none), the px
+                           // along it it peaks at, half the stretch that moves as one (px), and how fast it
+                           // moves in there now (px/s)
+uniform vec4 press;        // or a press on the surface: its centre (px), radius (px), and pressure
+                           // (px^2/s^2, as c^2 times the height it would push down by)
+uniform vec3 breeze;       // how hard the breeze's gusts press (px^2/s^2; 0: none), how big they are (px),
+                           // and the time in their turns (they come and go once a turn)
+uniform vec4 shore;        // the shore: how far in from the rim it runs on average and how far it wanders
+                           // either way (px), how long its bends are (px), and a seed for their shape
+uniform vec3 bed;          // the floor: how much deeper or shallower it gets (0..1 of the average), how long
+                           // its swells are (px), and a seed for their shape
+
+out vec4 fragColor;
+
+vec4 fetch(ivec2 c)
+{
+    ivec2 n = textureSize(state, 0);
+    if (c.x < 0 || c.y < 0 || c.x >= n.x || c.y >= n.y) {
+        return vec4(0.0); // past a texture that has just grown: dry
+    }
+    return texelFetch(state, c, 0);
+}
+
+float rim(vec2 p)
+{
+    return sdfRoundedBox(p, glass * 0.5, glass * 0.5, corners);
+}
+
+vec2 centre(ivec2 c)
+{
+    return (vec2(c) - 0.5) * cell;
+}
+
+// gradient noise in space and time, about -0.5..0.5: smooth gusts without the lattice's squares that value
+// noise shows
+vec3 hash33(vec3 p)
+{
+    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
+    p += dot(p, p.yxz + 33.33);
+    return fract((p.xxy + p.yxx) * p.zyx) * 2.0 - 1.0;
+}
+
+float gnoise(vec3 x)
+{
+    vec3 i = floor(x);
+    vec3 f = x - i;
+    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
+    float n000 = dot(hash33(i), f);
+    float n100 = dot(hash33(i + vec3(1.0, 0.0, 0.0)), f - vec3(1.0, 0.0, 0.0));
+    float n010 = dot(hash33(i + vec3(0.0, 1.0, 0.0)), f - vec3(0.0, 1.0, 0.0));
+    float n110 = dot(hash33(i + vec3(1.0, 1.0, 0.0)), f - vec3(1.0, 1.0, 0.0));
+    float n001 = dot(hash33(i + vec3(0.0, 0.0, 1.0)), f - vec3(0.0, 0.0, 1.0));
+    float n101 = dot(hash33(i + vec3(1.0, 0.0, 1.0)), f - vec3(1.0, 0.0, 1.0));
+    float n011 = dot(hash33(i + vec3(0.0, 1.0, 1.0)), f - vec3(0.0, 1.0, 1.0));
+    float n111 = dot(hash33(i + vec3(1.0, 1.0, 1.0)), f - vec3(1.0, 1.0, 1.0));
+    return mix(mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y), mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y), u.z);
+}
+
+// a smooth pattern over the glass, -1..1 or so, in bends about `size` px long: three plane waves at odd
+// angles and lengths, shifted by `seed` (cheap, and with no lattice to show)
+float pattern(vec2 p, float size, float seed)
+{
+    vec2 q = p / size * 6.2831853;
+    return 0.55 * sin(dot(q, vec2(0.83, 0.56)) + seed)
+         + 0.35 * sin(dot(q, vec2(-0.48, 1.31)) + 2.3 * seed + 1.1)
+         + 0.25 * sin(dot(q, vec2(1.62, -0.37)) + 3.7 * seed + 2.9);
+}
+
+// how far p is past the liquid's edge (negative in the liquid): the rim moved in by shore.x, wandering by
+// up to about shore.y either way
+float shoreline(vec2 p)
+{
+    return rim(p) + shore.x + shore.y * pattern(p, shore.z, shore.w);
+}
+
+// which side of the glass p is nearest: 0 left, 1 right, 2 top, 3 bottom
+float nearestSide(vec2 p)
+{
+    vec4 d = vec4(p.x, glass.x - p.x, p.y, glass.y - p.y);
+    float side = 0.0;
+    float best = d.x;
+    if (d.y < best) {
+        best = d.y;
+        side = 1.0;
+    }
+    if (d.z < best) {
+        best = d.z;
+        side = 2.0;
+    }
+    if (d.w < best) {
+        side = 3.0;
+    }
+    return side;
+}
+
+// how far side `side` moves in at the shore's face p: the busy push bows it in, most at push.y along it, not
+// at all at its ends; the stretch push.z either side of its peak moves as one. Only the stretch of shore
+// along that side moves (its bends may face another way here and there).
+float pushed(float side, vec2 p)
+{
+    if (abs(side - push.x) > 0.5 || abs(nearestSide(p) - side) > 0.5) {
+        return 0.0;
+    }
+    float s = side < 1.5 ? p.y : p.x;
+    float len = side < 1.5 ? glass.y : glass.x;
+    float sw = s - clamp(s - push.y, -push.z, push.z);
+    float a = clamp(push.y / len, 0.02, 0.98);
+    float f = sin(3.14159265 * pow(clamp(sw / len, 0.0, 1.0), log(0.5) / log(a)));
+    return push.w * f * f;
+}
+
+// what presses on the surface at p (px^2/s^2): the press, and the breeze
+float pressure(vec2 p)
+{
+    float sum = 0.0;
+    if (press.w != 0.0) {
+        vec2 d = (p - press.xy) / press.z;
+        sum += press.w * exp(-dot(d, d));
+    }
+    if (breeze.x != 0.0) {
+        sum += breeze.x * gnoise(vec3(p / breeze.y, breeze.z));
+    }
+    return sum;
+}
+
+// how deep the floor is at p against the average: 1 +- bed.x
+float depth(vec2 p)
+{
+    return 1.0 + bed.x * pattern(p, bed.y, bed.z) / 1.15;
+}
+
+// a face's new velocity: between cells a and b (b to the right of a or below it), along `axis` (0 x, 1 y),
+// its old velocity `v`, the heights, pressures, shorelines (wet where under 0) and depths either side
+float face(ivec2 a, ivec2 b, int axis, float v, float ha, float hb, float pa, float pb, float sa, float sb, float da, float db)
+{
+    bool wa = sa < 0.0;
+    bool wb = sb < 0.0;
+    vec2 p = 0.5 * (centre(a) + centre(b)); // the face's middle
+    if (wa && wb) {
+        float dt = timing.x;
+        float force = -timing.y * 0.5 * (da + db) * (hb - ha) / cell - (pb - pa) / cell + (axis == 0 ? accel.x : accel.y);
+        float sponge = damping.y * pow(clamp(1.0 + 0.5 * (sa + sb) / damping.z, 0.0, 1.0), 2.0);
+        return (v + dt * force) * exp(-(damping.x + sponge) * dt);
+    }
+    if (wa == wb) {
+        return 0.0; // dry on both sides
+    }
+    // the shore: the liquid follows its side where the push moves it (positive: towards +x or +y)
+    if (axis == 0) {
+        return wb ? pushed(0.0, p) // the left side, liquid to its right
+                  : -pushed(1.0, p);
+    }
+    return wb ? pushed(2.0, p) // the top, liquid below
+              : -pushed(3.0, p);
+}
+
+// a cell's state (wet: whether it holds liquid now); if the glass has just grown over it, at the level of
+// the nearest liquid above it or to its left (up to 32 cells off: the glass grows less than that in a
+// frame), at rest
+vec4 cellAt(ivec2 c, bool wet)
+{
+    vec4 s = fetch(c);
+    if (s.w > 0.0 || !wet) {
+        return s;
+    }
+    for (int k = 1; k <= 32; ++k) {
+        vec4 t = fetch(c - ivec2(0, k));
+        if (t.w > 0.0) {
+            return vec4(t.x, 0.0, 0.0, 0.0);
+        }
+        t = fetch(c - ivec2(k, 0));
+        if (t.w > 0.0) {
+            return vec4(t.x, 0.0, 0.0, 0.0);
+        }
+    }
+    return vec4(0.0);
+}
+
+void main(void)
+{
+    ivec2 c = ivec2(gl_FragCoord.xy);
+    // the shoreline here and at the four neighbours, once (it's two noises each)
+    float sHere = shoreline(centre(c));
+    if (sHere >= 0.0) {
+        fragColor = vec4(0.0); // dry
+        return;
+    }
+    float sLeft = shoreline(centre(c - ivec2(1, 0)));
+    float sRight = shoreline(centre(c + ivec2(1, 0)));
+    float sAbove = shoreline(centre(c - ivec2(0, 1)));
+    float sBelow = shoreline(centre(c + ivec2(0, 1)));
+    float dHere = depth(centre(c));
+    vec4 here = cellAt(c, true);
+    vec4 left = cellAt(c - ivec2(1, 0), sLeft < 0.0);
+    vec4 right = cellAt(c + ivec2(1, 0), sRight < 0.0);
+    vec4 above = cellAt(c - ivec2(0, 1), sAbove < 0.0);
+    vec4 below = cellAt(c + ivec2(0, 1), sBelow < 0.0);
+
+    float p = pressure(centre(c));
+    float uR = face(c, c + ivec2(1, 0), 0, here.y, here.x, right.x, p, pressure(centre(c + ivec2(1, 0))), sHere, sRight,
+                    dHere, depth(centre(c + ivec2(1, 0))));
+    float uL = face(c - ivec2(1, 0), c, 0, left.y, left.x, here.x, pressure(centre(c - ivec2(1, 0))), p, sLeft, sHere,
+                    depth(centre(c - ivec2(1, 0))), dHere);
+    float vB = face(c, c + ivec2(0, 1), 1, here.z, here.x, below.x, p, pressure(centre(c + ivec2(0, 1))), sHere, sBelow,
+                    dHere, depth(centre(c + ivec2(0, 1))));
+    float vT = face(c - ivec2(0, 1), c, 1, above.z, above.x, here.x, pressure(centre(c - ivec2(0, 1))), p, sAbove, sHere,
+                    depth(centre(c - ivec2(0, 1))), dHere);
+
+    float dt = timing.x;
+    float h = here.x - dt * ((uR - uL) + (vB - vT)) / cell;
+    // a little diffusion among wet cells, which only the shortest waves (a few cells) feel
+    float lap = 0.0;
+    lap += sLeft < 0.0 ? left.x - here.x : 0.0;
+    lap += sRight < 0.0 ? right.x - here.x : 0.0;
+    lap += sAbove < 0.0 ? above.x - here.x : 0.0;
+    lap += sBelow < 0.0 ? below.x - here.x : 0.0;
+    h += dt * timing.z * lap / (cell * cell);
+    // and the level settles back to rest (what the push leaves, or a cell the glass grew over)
+    h *= exp(-timing.w * dt);
+    fragColor = vec4(h, uR, vB, 1.0);
+}
diff -ruN '--exclude=*.orig' '--exclude=*.rej' a/src/plugins/blur/shaders/onscreen_bevel.frag b/src/plugins/blur/shaders/onscreen_bevel.frag
--- a/src/plugins/blur/shaders/onscreen_bevel.frag
+++ b/src/plugins/blur/shaders/onscreen_bevel.frag
@@ -0,0 +1,107 @@
+#version 140
+
+#include "sdf.glsl"
+
+// The blur behind a Liquid Glass surface (plasma-glass), seen through the glass's bevel: within bevel.x of
+// the edge the glass rounds off like a quarter circle, so it refracts the same frosted view as the rest of
+// the glass, from further in the steeper it is (bevel.y at the very edge), and sharper towards the edge,
+// where it's polished (bevel.w: how much of what's behind shows as it is, at the very edge). Blue bends
+// more than red: the colours part along the edge by bevel.z each way. While the liquid in the glass moves
+// (KRunner's: surface.frag), its waves lean the glass too, and bend what's behind it the same way: a
+// fresh wave's steepest slope as far as the bevel at its edge, with its colours parting a little more
+// (ripple.z where one leans fully). A ripple clears the glass where it runs, over its crests and troughs
+// too, where it doesn't lean: by its height (up or down), where that's more.
+
+uniform sampler2D texUnit;   // the blurred background at half size (its last upsample step is done here)
+uniform sampler2D sharpUnit; // the background as it is
+uniform mat4 colorMatrix;
+uniform float offset;
+uniform vec2 halfpixel;
+uniform vec4 box;          // the glass: centre and half size
+uniform vec4 cornerRadius; // top left, top right, bottom left, bottom right
+uniform float opacity;
+uniform vec2 size;         // the background's size
+uniform vec4 bevel;        // width, refraction, dispersion (device px), sharpness at the edge (0..1)
+uniform sampler2D wavesUnit; // the liquid's surface: its slope (x, y) and the ripples' height, at half size
+uniform vec3 ripple;         // while they run: what a wave's slope is multiplied by to lean the glass, and
+                             // its height to clear it (0: no waves); how far its colours part where one
+                             // leans the glass fully (device px)
+
+in vec2 uv;
+in vec2 vertex; // device px from the background's top left
+
+out vec4 fragColor;
+
+vec4 blurred(vec2 at)
+{
+    vec4 sum = texture(texUnit, at + vec2(-halfpixel.x * 2.0, 0.0) * offset);
+    sum += texture(texUnit, at + vec2(-halfpixel.x, halfpixel.y) * offset) * 2.0;
+    sum += texture(texUnit, at + vec2(0.0, halfpixel.y * 2.0) * offset);
+    sum += texture(texUnit, at + vec2(halfpixel.x, halfpixel.y) * offset) * 2.0;
+    sum += texture(texUnit, at + vec2(halfpixel.x * 2.0, 0.0) * offset);
+    sum += texture(texUnit, at + vec2(halfpixel.x, -halfpixel.y) * offset) * 2.0;
+    sum += texture(texUnit, at + vec2(0.0, -halfpixel.y * 2.0) * offset);
+    sum += texture(texUnit, at + vec2(-halfpixel.x, -halfpixel.y) * offset) * 2.0;
+    return sum / 12.0;
+}
+
+// texture coordinates of device px p
+vec2 at(vec2 p)
+{
+    return vec2(p.x / size.x, 1.0 - p.y / size.y);
+}
+
+float outline(vec2 p)
+{
+    return sdfRoundedBox(p, box.xy, box.zw, cornerRadius);
+}
+
+void main(void)
+{
+    float f = outline(vertex);
+    float df = fwidth(f);
+    float d = -f; // px inside the glass
+
+    // which way the glass faces here, and how far it leans that way (the sine of its tilt); and how clear
+    // it is, from frosted (0) to clear (1)
+    vec2 lean = vec2(0.0);
+    float clear = 0.0;
+    vec2 waveLean = vec2(0.0); // the waves' part of it
+    if (d < bevel.x) {
+        // the bevel: out of the glass, across the outline; a quarter circle, so 1 at the edge and 0 where
+        // the glass turns flat; clear as far as it leans
+        vec2 g = vec2(outline(vertex + vec2(0.5, 0.0)) - outline(vertex - vec2(0.5, 0.0)),
+                      outline(vertex + vec2(0.0, 0.5)) - outline(vertex - vec2(0.0, 0.5)));
+        lean = g / max(length(g), 1e-4) * (1.0 - max(d, 0.0) / bevel.x);
+        clear = length(lean);
+    }
+    if (ripple.x > 0.0) {
+        vec3 wave = texture(wavesUnit, uv).xyz;
+        waveLean = -wave.xy * ripple.x; // a wave faces downhill
+        lean += waveLean;
+        clear = max(clear, max(length(waveLean), abs(wave.z) * ripple.y));
+    }
+    float tilt = min(length(lean), 1.0);
+    clear = min(clear, 1.0);
+
+    vec4 color;
+    if (tilt > 1e-3 || clear > 1e-3) {
+        vec2 facing = lean / max(length(lean), 1e-6);
+        vec2 p = vertex - facing * bevel.y * tilt * tilt; // refracted: seen from further in, most where it's steep
+        // (a smooth start where the glass is flat; keep bevel.y under half bevel.x, or the bevel folds over)
+        // red from a little further out, blue from further in: as far as the glass leans, and a little
+        // further as far as a wave leans it
+        vec2 split = facing * bevel.z * tilt + waveLean / max(length(waveLean), 1.0) * (ripple.z - bevel.z);
+        // the colours part only in the sharp view: on the frost it wouldn't show, and it would take the
+        // blur's 8 samples three times over
+        vec4 sharp = texture(sharpUnit, at(p));
+        sharp.r = texture(sharpUnit, at(p + split)).r;
+        sharp.b = texture(sharpUnit, at(p - split)).b;
+        color = mix(blurred(at(p)), sharp, bevel.w * clear);
+    } else {
+        color = blurred(uv);
+    }
+
+    fragColor = color * colorMatrix * opacity;
+    fragColor *= 1.0 - clamp(0.5 + f / df, 0.0, 1.0);
+}
diff -ruN '--exclude=*.orig' '--exclude=*.rej' a/src/plugins/blur/shaders/surface.frag b/src/plugins/blur/shaders/surface.frag
--- a/src/plugins/blur/shaders/surface.frag
+++ b/src/plugins/blur/shaders/surface.frag
@@ -0,0 +1,57 @@
+#version 140
+
+// plasma-glass: the liquid's surface over the background behind a Liquid Glass window, for the bevel pass
+// (and Liquid Glass Light's underlay) to bend what's behind by: its slope (x, y), the ripples' height and
+// the swell's, at half size. The liquid runs in two layers of its own (fluid.frag), which add up:
+// ripples, the short waves (on cells of ripplesCell px), and swell, the long ones that slosh (swellCell
+// px). Past the liquid's wavy edge, a little in from the rim, there are none.
+
+uniform sampler2D ripples;
+uniform sampler2D swell;
+uniform float ripplesCell;
+uniform float swellCell;
+uniform vec2 origin;  // the background's top left in the glass
+uniform vec2 area;    // its size, logical px
+uniform vec4 gain;    // what the ripples' and the swell's slopes are multiplied by; what their heights
+                      // are divided by (a fresh wave's crest, and a slosh's that leans the glass fully,
+                      // come out as 1)
+
+in vec2 uv;
+
+out vec4 fragColor;
+
+// the height at p from the wet cells around it only (dry ones hold 0 and say so in w, so the filtered
+// height over the filtered wetness leaves them out), and how much of p is wet (0 past the liquid's edge)
+vec2 height(sampler2D layer, float cell, vec2 p)
+{
+    vec4 s = texture(layer, (p / cell + 1.0) / vec2(textureSize(layer, 0)));
+    return vec2(s.x / max(s.w, 1e-3), s.w);
+}
+
+// the slope at p, fading out across the last cell before the liquid's edge (no liquid, no waves); and the
+// height
+vec3 surface(sampler2D layer, float cell, vec2 p)
+{
+    vec2 r = height(layer, cell, p + vec2(cell, 0.0));
+    vec2 l = height(layer, cell, p - vec2(cell, 0.0));
+    vec2 d = height(layer, cell, p + vec2(0.0, cell));
+    vec2 u = height(layer, cell, p - vec2(0.0, cell));
+    vec2 c = height(layer, cell, p);
+    float wet = smoothstep(0.05, 0.9, min(min(min(r.y, l.y), min(d.y, u.y)), c.y));
+    return vec3(vec2(r.x - l.x, d.x - u.x) / (2.0 * cell), c.x) * wet;
+}
+
+void main(void)
+{
+    // the background is drawn with v from 1 at its top, as the blur's passes are
+    vec2 p = origin + vec2(uv.x, 1.0 - uv.y) * area;
+    vec3 ripple = surface(ripples, ripplesCell, p);
+    vec2 s = gain.x * ripple.xy;
+    float swellHeight = 0.0;
+    if (gain.y != 0.0) {
+        vec3 sloshed = surface(swell, swellCell, p);
+        s += gain.y * sloshed.xy;
+        swellHeight = sloshed.z / gain.w;
+    }
+    fragColor = vec4(s, ripple.z / gain.z, swellHeight);
+}
diff -ruN '--exclude=*.orig' '--exclude=*.rej' a/src/plugins/blur/shaders/underlay.frag b/src/plugins/blur/shaders/underlay.frag
--- a/src/plugins/blur/shaders/underlay.frag
+++ b/src/plugins/blur/shaders/underlay.frag
@@ -0,0 +1,85 @@
+#version 140
+
+// The liquid in KRunner's glass on Liquid Glass Light (plasma-glass), beneath the frost: what's behind the
+// glass, bent by the waves (seen from further in where a wave leans, as through a lens) and lit in shards
+// of colour where they crest, as off an etched diffraction foil. The blur's passes then frost this, so the
+// waves show through the frosting, softened. In: the background as it is, and the liquid's slope and
+// heights (surface.frag: the ripples' and the swell's) at half size. Out: the background to frost.
+
+uniform sampler2D texUnit;   // the background as it is
+uniform sampler2D wavesUnit; // the waves: the glass's slope (x, y), the ripples' height and the swell's
+uniform vec2 size;           // the background's size, device px
+uniform vec2 origin;         // its top left in the window, logical px
+uniform vec2 area;           // its size, logical px
+uniform float lean;          // what a wave's slope is multiplied by to lean the glass
+uniform vec4 light;          // device px what's behind is seen from further in where a wave leans fully;
+                             // how bright the foil's colours are; its shards' size (logical px); how
+                             // saturated they are (0: white)
+uniform float time;          // s, for the colours' slow drift
+
+in vec2 uv;
+
+out vec4 fragColor;
+
+// hashes without sine (Dave Hoskins), stable in float precision
+float hash12(vec2 p)
+{
+    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.x + p3.y) * p3.z);
+}
+
+vec2 hash22(vec2 p)
+{
+    vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.xx + p3.yz) * p3.zy);
+}
+
+// a rainbow: w 0 (red) .. 1 (violet)
+vec3 spectral(float w)
+{
+    vec3 x = 3.2 * (w - vec3(0.18, 0.48, 0.78));
+    vec3 c = max(1.0 - x * x, 0.0);
+    c.r += 0.35 * max(1.0 - 10.0 * (w - 1.0) * (w - 1.0), 0.0); // violet has some red
+    return c;
+}
+
+void main(void)
+{
+    vec4 wave = texture(wavesUnit, uv);
+    vec2 waveLean = -wave.xy * lean; // a wave faces downhill
+    float tilt = min(length(waveLean), 1.0);
+    vec2 facing = waveLean / max(length(waveLean), 1e-6);
+    // seen from further in, most where it's steep (the background is drawn with v from 1 at its top)
+    vec2 shift = facing * light.x * tilt * tilt / size;
+    vec4 color = texture(texUnit, uv + vec2(-shift.x, shift.y));
+
+    // the busy pushes' crests, and the sloshing's (where the window's moves heap the liquid up)
+    float crest = max(wave.z, 0.0) + max(wave.w, 0.0);
+    if (crest > 0.002 && light.y > 0.0) {
+        // the foil's shard here: the Voronoi cells of a jittered grid, light.z logical px across, fixed to
+        // the window, each with its own colour and sparkle
+        vec2 q = (origin + vec2(uv.x, 1.0 - uv.y) * area) / light.z;
+        vec2 cell = floor(q);
+        vec2 f = q - cell;
+        float best = 8.0;
+        vec2 id = cell;
+        for (int j = -1; j <= 1; ++j) {
+            for (int i = -1; i <= 1; ++i) {
+                vec2 o = vec2(float(i), float(j)) + hash22(cell + vec2(float(i), float(j))) - f;
+                float d2 = dot(o, o);
+                if (d2 < best) {
+                    best = d2;
+                    id = cell + vec2(float(i), float(j));
+                }
+            }
+        }
+        float hue = hash22(id + 17.17).y;
+        float sparkle = 0.3 + 0.7 * hash12(id + 3.7);
+        vec3 tint = mix(vec3(1.0), spectral(fract(hue + 0.03 * time)), light.w);
+        // light the crests give off, beneath the frost
+        color.rgb += tint * light.y * sparkle * min(crest, 1.0) * color.a;
+    }
+    fragColor = color;
+}

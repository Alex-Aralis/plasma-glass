+
+// A wave's profile across its front, x half-widths ahead of its crest (behind it, x < 0), as a knock leaves
+// it in a dispersive medium: a smooth rise ahead, the crest, then a ringing train behind, ripples that get
+// shorter and fade (an Airy function's tail, damped), over D half-widths by e: at D 1.7, -0.42, +0.18,
+// -0.09, +0.05 of the crest, under 1% from 9 half-widths behind (1.4 + 4.6 D). Out: the height and its
+// slope per half-width, whose steepest at D 1.7 is 0.991 (just behind the crest; the front's is 0.858).
+vec2 profile(float x, float D)
+{
+    if (x >= 0.0) {
+        float h = exp(-x * x);
+        return vec2(h, -2.0 * x * h);
+    }
+    const float C = 1.4; // half-widths over which the envelope rounds off at the crest
+    const float U = 2.6; // half-widths behind the crest to the first trough; the ripples' phase goes as u^1.5
+    float u = -x;
+    float r = sqrt(u * u + C * C);
+    float e = exp(-(r - C) / D);
+    float de = -u / (r * D) * e;
+    float ph = 3.14159265 * pow(u / U, 1.5);
+    float dph = 1.5 * 3.14159265 / U * sqrt(u / U);
+    return vec2(e * cos(ph), -(de * cos(ph) - e * sin(ph) * dph)); // per x: minus the slope per u
+}
+
+// One knock's wave at p: adds its slope and height. The flex starts on a 1 px stretch at once and slows
+// down over 30 px to the waves' speed (its time per px rises as a smoothstep), so the wave leaves as a
+// short, rounded front. `die`: how much of a wave heading for the nearest rim is left at p; `toRim`: the
+// way to that rim.
+void knock(vec2 p, vec4 k, vec4 shape, float die, vec2 toRim, inout vec2 slope, inout float height)
+{
+    if (shape.x <= 0.0)
+        return;
+    // p in the side's terms: n px in from it, s px along it (len long); `inward`, `along`: those directions
+    float n;
+    float s;
+    float len;
+    vec2 inward;
+    vec2 along;
+    if (k.x < 0.5) {
+        n = p.x; s = p.y; len = size.y; inward = vec2(1.0, 0.0); along = vec2(0.0, 1.0);
+    } else if (k.x < 1.5) {
+        n = size.x - p.x; s = p.y; len = size.y; inward = vec2(-1.0, 0.0); along = vec2(0.0, 1.0);
+    } else if (k.x < 2.5) {
+        n = p.y; s = p.x; len = size.x; inward = vec2(0.0, 1.0); along = vec2(1.0, 0.0);
+    } else {
+        n = size.y - p.y; s = p.x; len = size.x; inward = vec2(0.0, -1.0); along = vec2(1.0, 0.0);
+    }
+    float front = k.z;
+    float wb = k.w;
+    float a = abs(s - k.y);
+    // The wave has come between n and the straight line from the knock; 2.5 half-widths ahead of its crest
+    // and past its ringing behind (1.4 + 4.6 x its fade, 9 at the default), what's left (under 1% of its
+    // height) doesn't show
+    float behind = front - (1.4 + 4.6 * shape.z) * wb;
+    if (front + 2.5 * wb < n || (behind > 0.0 && behind * behind > a * a + n * n))
+        return;
+    // The first wave to reach p left the side where the flex's time to get there plus the path on to p is
+    // shortest (both as distances at the waves' speed). That's convex along the side: bisect its slope.
+    // Past the 30 px where the flex slows down it moves as fast as the waves, so no later start is shorter:
+    // the search only spans those 30 px, and 4 halvings do (an error there changes `from` only to second
+    // order).
+    const float w = 0.5;  // half the stretch that moves at once (px)
+    const float L = 30.0; // px over which the flex slows down to the waves' speed
+    float from = n;       // how far the wave has come
+    vec2 dir = inward;    // and its direction at p
+    if (a > w) {
+        float lo = w;
+        float hi = min(a, w + L);
+        for (int i = 0; i < 4; ++i) {
+            float mid = 0.5 * (lo + hi);
+            float xm = clamp((mid - w) / L, 0.0, 1.0);
+            float dm = a - mid;
+            if (xm * xm * (3.0 - 2.0 * xm) < dm / sqrt(dm * dm + n * n + 1e-6))
+                lo = mid;
+            else
+                hi = mid;
+        }
+        float d = 0.5 * (lo + hi);
+        float xd = clamp((d - w) / L, 0.0, 1.0);
+        float dd = a - d;
+        float r = sqrt(dd * dd + n * n);
+        from = L * xd * xd * xd * (1.0 - 0.5 * xd) + max(d - w - L, 0.0) + r;
+        dir = (n * inward + sign(s - k.y) * dd * along) / max(r, 1e-3);
+    }
+    // how strongly the side moves there: sin^2 of a warped position that puts its peak at the knock
+    float flex = sin(3.14159265 * pow(clamp(s / len, 0.0, 1.0), shape.y));
+    float fade = flex * flex * shape.x * mix(1.0, die, smoothstep(-0.3, 0.3, dot(dir, toRim)));
+    vec2 shape_ = profile((from - front) / wb, shape.z);
+    slope += steep * fade * (shape_.y / shape.w) * dir; // its steepest is a fresh wave's steepest
+    height += fade * shape_.x;
+}
+
+void main(void)
+{
+    // the background is drawn with v from 1 at its top, as the blur's passes are
+    vec2 p = origin + vec2(uv.x, 1.0 - uv.y) * area;
+    vec4 dist = vec4(p.x, size.x - p.x, p.y, size.y - p.y); // to the left, right, top, bottom edge
+    // a wave heading into the rim runs on across the bevel and fades out only at the very edge: at an edge
+    // of 3, half of it is left 3 px from the rim, 90% 6 px in (from 15 px in, all of it)
+    float die = 1.0;
+    vec2 toRim = vec2(0.0);
+    if (min(min(dist.x, dist.y), min(dist.z, dist.w)) < 5.0 * edge) {
+        vec4 ed = exp(-dist / edge);
+        float near = ed.x + ed.y + ed.z + ed.w;
+        die = exp(-(near * near) / (0.45 * 0.45));
+        vec4 e = exp(-dist / 20.0);
+        vec2 rimward = vec2(e.y - e.x, e.w - e.z);
+        toRim = rimward / max(length(rimward), 1e-4);
+    }
+    vec2 slope = vec2(0.0);
+    float height = 0.0;
+    for (int i = 0; i < 8; ++i) {
+        knock(p, knocks[i], shapes[i], die, toRim, slope, height);
+    }
+    fragColor = vec4(slope, height, 1.0);
+}

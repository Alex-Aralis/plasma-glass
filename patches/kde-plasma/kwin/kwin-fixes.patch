+// The corners of a blur shape that a Liquid Glass frame rounds off (none: it's not one)
+static BorderRadius liquidGlassCorners(const RegionF &shape, const RectF &bounds)
+{
+    const auto cut = [&shape](qreal x, qreal y) {
+        return shape.contains(QPointF(x, y)) ? 0.0 : s_liquidGlassRadius;
+    };
+    const qreal left = bounds.left() + 0.5;
+    const qreal right = bounds.right() - 0.5;
+    const qreal top = bounds.top() + 0.5;
+    const qreal bottom = bounds.bottom() - 0.5;
+    return BorderRadius(cut(left, top), cut(right, top), cut(right, bottom), cut(left, bottom));
+}

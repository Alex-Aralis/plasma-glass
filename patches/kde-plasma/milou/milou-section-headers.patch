+    // A file's subtext (where it is) shows on every row, not just the current one, so files can be told
+    // apart at a glance; hovering the row shows its full path there instead, scrolling if it doesn't fit.
+    readonly property string filePath: {
+        const urls = model.urls || [];
+        const url = urls.length > 0 ? String(urls[0]) : "";
+        if (!url.startsWith("file://")) {
+            return "";
+        }
+        const path = decodeURIComponent(url.slice(7));
+        const home = decodeURIComponent(String(StandardPaths.writableLocation(StandardPaths.HomeLocation)).slice(7));
+        return home && (path === home || path.startsWith(home + "/")) ? "~" + path.slice(home.length) : path;
+    }

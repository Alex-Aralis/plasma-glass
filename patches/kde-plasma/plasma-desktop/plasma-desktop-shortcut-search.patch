+void KCMKeys::showArguments()
+{
+    // systemsettings splits --args at spaces, and a component id can hold some ("KDE Keyboard Layout
+    // Switcher"): the component is the longest run of leading words that is one, the rest the action
+    const QStringList args = std::exchange(m_arguments, {});
+    QModelIndex component;
+    qsizetype words = args.size();
+    for (; words > 0; --words) {
+        const QString id = args.first(words).join(QLatin1Char(' '));
+        for (int i = 0, c = m_shortcutsModel->rowCount(); i < c && !component.isValid(); ++i) {
+            if (m_shortcutsModel->index(i, 0).data(BaseModel::ComponentRole).toString() == id) {
+                component = m_shortcutsModel->index(i, 0);
+            }
+        }
+        if (component.isValid()) {
+            break;
+        }
+    }
+    if (!component.isValid()) {
+        return;
+    }
+    const QString action = args.sliced(words).join(QLatin1Char(' '));
+    Q_EMIT searchRequested(action); // the search field, whose binding filters the lists
+    m_filteredModel->setFilter(action); // (the same, should the binding not have run yet)
+    const QModelIndex shown = m_filteredModel->mapFromSource(component);
+    if (!shown.isValid()) {
+        return;
+    }
+    // the action by its name; an app's launch action shows as "Launch", so it's asked for by the app's name
+    int actionRow = -1;
+    const int count = action.isEmpty() ? 0 : m_filteredModel->rowCount(shown);
+    for (int i = 0; i < count && actionRow < 0; ++i) {
+        if (m_filteredModel->index(i, 0, shown).data(Qt::DisplayRole).toString().compare(action, Qt::CaseInsensitive) == 0) {
+            actionRow = i;
+        }
+    }
+    for (int i = 0; i < count && actionRow < 0; ++i) {
+        if (m_filteredModel->index(i, 0, shown).data(BaseModel::ActionRole).toString() == QLatin1String("_launch")
+            && shown.data(Qt::DisplayRole).toString().compare(action, Qt::CaseInsensitive) == 0) {
+            actionRow = i;
+        }
+    }
+    Q_EMIT showAction(shown.row(), actionRow);
+}
